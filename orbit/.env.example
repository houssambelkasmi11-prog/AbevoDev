# ─────────────────────────────────────────────────────────────
#  ORBIT — environment template
#  Copy to .env.local (or run `npm run setup`, which generates secrets).
# ─────────────────────────────────────────────────────────────

# Backend mode: "local" (JSON store in ./.orbit-data, zero setup)
# or "supabase" (Postgres + Auth + Storage + pgvector).
# If unset, ORBIT uses Supabase when the two NEXT_PUBLIC_SUPABASE_* vars exist.
ORBIT_BACKEND=local

# Public site URL (used for auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OPTIONAL — 32-byte base64 key used to encrypt provider API keys at rest (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# If unset, ORBIT derives one from SUPABASE_JWT_SECRET / SUPABASE_SERVICE_ROLE_KEY /
# ORBIT_SESSION_SECRET, or (local mode) generates .orbit-data/encryption.key.
# Users only ever paste their AI provider key in the app.
ORBIT_ENCRYPTION_KEY=

# Secret used to sign local-mode session cookies (any long random string).
ORBIT_SESSION_SECRET=

# ── Supabase (only for ORBIT_BACKEND=supabase) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Storage bucket for uploaded sources (created by the migration)
SUPABASE_STORAGE_BUCKET=sources

# ── Optional: allow the custom OpenAI-compatible endpoint to target private hosts
# (e.g. a local Ollama / LM Studio server). Off by default to prevent SSRF.
ORBIT_ALLOW_PRIVATE_ENDPOINTS=false
